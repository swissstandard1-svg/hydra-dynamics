{
  "name": "hydra-dynamics",
  "private": true,
  "version": "1.0.0",
  "description": "HYDRA Dynamics — Konzept-Website für flüssigkeitsgekühlte KI-Rechenzentren (Design- und Coding-Benchmark, fiktive Marke)",
  "type": "module",
  "scripts": {
    "dev": "npm run build:css && node tools/vite.mjs serve",
    "build:css": "node tools/build-css.mjs",
    "build": "npm run build:css && tsc --noEmit && node tools/vite.mjs build",
    "preview": "node tools/vite.mjs serve",
    "typecheck": "tsc --noEmit",
    "lh": "node tools/lighthouse.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.2.5",
    "@fontsource-variable/space-grotesk": "^5.2.8",
    "gsap": "^3.15.0",
    "lenis": "^1.3.26",
    "motion": "^13.4.2"
  },
  "devDependencies": {
    "@lhci/cli": "^0.15.1",
    "@tailwindcss/vite": "^4.3.3",
    "chrome-launcher": "^1.2.0",
    "lighthouse": "^12.8.2",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
}
